          "_name": "content8",
          "_sourceTheme": "mobirise5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"content8\" group=\"Content\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"1\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"0\">\n        <input type=\"range\" name=\"textWidth\" title=\"Width\" min=\"4\" max=\"12\" value=\"11\" step=\"1\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\">\n        <input type=\"checkbox\" title=\"Stylized\" name=\"stylizedCounters\" checked>\n        <input type=\"checkbox\" title=\"Mark\" name=\"mark\" condition=\"stylizedCounters\" checked>\n        <select title=\"Type\" name=\"countersType\" condition=\"stylizedCounters\">\n            <option value=\"default\" selected>Ð¡ircle Fill</option>\n            <option value=\"circle\">Circle</option>\n            <option value=\"square\">Square</option>\n        </select>\n        <input type=\"color\" name=\"iconColor\" title=\"Color\" value=\"#b1ebff\">\n        <header>Background</header>\n        <input type=\"color\" title=\"Color\" name=\"bgColor\" value=\"#ffffff\">\n    </mbr-parameters>\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row justify-content-center\">\n            <div class=\"counter-container col-md-12 col-lg-{{textWidth}}\">\n                <h4 class=\"mbr-section-title mbr-fonts-style mb-4\" mbr-if=\"showTitle\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-5\">\n                    Shape your future web project with the Mobirise app.\n                </h4>\n                <div class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".mbr-text\" data-multiline mbr-article>\n                    <div><b style=\"font-size: 1.5rem;\">Supports Prostate Health –</b><span style=\"font-size: 1.5rem;\"> Helps support healthy prostate function and overall prostate wellness as part of a healthy lifestyle.</span></div><div><b style=\"font-size: 1.5rem;\"><br></b></div><div><b style=\"font-size: 1.5rem;\">Supports Urinary Comfort –</b><span style=\"font-size: 1.5rem;\"> Helps maintain healthy urinary function and comfortable urine flow for greater everyday confidence.</span><br></div><div><b><br></b></div><div><b>Supports Nighttime Comfort – </b>Designed to support urinary wellness, including nighttime comfort, helping you maintain a more restful routine.</div><div><b><br></b></div><div><b>Promotes Energy and Stamina – </b>Supports natural energy, vitality, and stamina to help you stay active and productive throughout the day.</div><div><b><br></b></div><div><b>Supports Sexual Wellness – </b>Helps support healthy libido, circulation, and overall male sexual wellness.</div><div><b><br></b></div><div><b>Supports Healthy Hormonal Balance –</b> Provides ingredients traditionally used to support healthy hormone balance and overall male vitality.</div><div><b><br></b></div><div><b>Supports a Healthy Inflammatory Response – </b>Contains carefully selected ingredients that help support the body’s natural inflammatory balance and prostate wellness.</div><div><b><br></b></div><div><b>Promotes Overall Male Wellness – </b>Supports general vitality and wellness as part of a balanced diet and healthy lifestyle.</div><div><b><br></b></div><div><b>Supports Mood and Mental Clarity – </b>By supporting overall energy, vitality, and healthy daily routines, ProstaVive can complement your efforts to maintain focus and well-being.</div><div><b><br></b></div><div><b>Supports Cellular and Antioxidant Health –</b> Provides ingredients with antioxidant properties that help support healthy cellular function and the body's natural defenses.</div><div><b><br></b></div><ul><li>\n</li><li>\n</li><li>\n</li><li>\n</li><li><b>\n</b></li><li><b>\n</b></li><li><b>\n</b></li><li><b>\n</b></li><li><b>\n</b></li><li><b>\n</b></li><li><span style=\"font-size: 1.5rem;\">\n</span></li><li><span style=\"font-size: 1.5rem;\">\n</span></li><li><span style=\"font-size: 1.5rem;\">\n</span></li><li><span style=\"font-size: 1.5rem;\">\n</span></li><li><span style=\"font-size: 1.5rem;\">\n</span></li><li><span style=\"font-size: 1.5rem;\">\n</span></li><li><span style=\"font-size: 1.5rem;\">\n</span></li><li><b>\n</b></li><li><b>\n</b></li><li><b>\n</b></li><li><b>\n</b></li><li><b>\n</b></li><li><b>\n</b></li><li><b>\n</b></li><li><b>\n</b></li><li><b>\n</b></li><li><b>\n</b></li><li><b>\n</b></li><li><b style=\"font-size: 1.5rem;\">\n</b></li><li><b style=\"font-size: 1.5rem;\">\n</b></li><li><b>\n</b></li><li><b>\n</b></li><li><b>\n</b></li><li><b>\n</b></li><li><b>\n</b></li><li><b>\n</b></li><li><b>\n</b></li><li><b>\n</b></li><li><b>\n</b></li><li><span style=\"font-size: 1.5rem;\"><b>\n</b></span></li><li><span style=\"font-size: 1.5rem;\"><b>\n</b></span></li><li><span style=\"font-size: 1.5rem;\"><b>\n</b></span></li><li><span style=\"font-size: 1.5rem;\"><b>\n</b></span></li><li><span style=\"font-size: 1.5rem;\"><b>\n</b></span></li><li><span style=\"font-size: 1.5rem;\"><b>\n</b></span></li><li><b>\n</b></li><li><b>\n</b></li><li><b>\n</b></li><li><b>\n</b></li><li><b>\n</b></li><li><b>\n</b></li><li><b>\n</b></li><li><b>\n</b></li>\n                    </ul>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
