    "terms-and-conditions.html": {
      "settings": {
        "title": "Terms and Conditions",
        "order": "3",
        "meta_descr": "Terms and Conditions for ProstaVive"
      },
      "components": [
        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
